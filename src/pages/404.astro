---
import Layout from '../layouts/Layout.astro';

// Dynamic domain resolution
const hostname = Astro.url.hostname || 'bengal.wiki';
const displayHost = hostname === 'localhost' || hostname === '127.0.0.1' ? 'bengal.wiki' : hostname;
---

<Layout title="Page not found" description="The page you are looking for does not exist on Bengal Wiki.">
	<div class="error-page">

		<!-- Error Code Block -->
		<div class="error-hero">
			<div class="error-code-wrap">
				<span class="error-digit">4</span>
				<span class="error-globe" aria-hidden="true">
					<!-- Inline SVG Bengal Wiki globe, reused from logo -->
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" class="globe-svg">
						<circle cx="30" cy="30" r="28" fill="#f8f9fa" stroke="#a2a9b1" stroke-width="1.5" />
						<ellipse cx="30" cy="30" rx="28" ry="10" fill="none" stroke="#eaecf0" stroke-width="1" />
						<ellipse cx="30" cy="30" rx="10" ry="28" fill="none" stroke="#eaecf0" stroke-width="1" />
						<line x1="2" y1="30" x2="58" y2="30" stroke="#eaecf0" stroke-width="1" />
						<path d="M12,20 C18,10 42,10 48,20 C50,25 45,35 40,40 C35,45 25,45 20,40 C15,35 10,25 12,20 Z" fill="#ffffff" opacity="0.9" stroke="#72777d" stroke-width="1" />
						<text x="30" y="38" text-anchor="middle" font-family="'Noto Serif Bengali', 'Georgia', serif" font-size="24" font-weight="bold" fill="#b11226">ব</text>
						<path d="M42,22 Q46,26 42,30" stroke="#fca311" stroke-width="2.5" stroke-linecap="round" fill="none" />
						<path d="M45,20 Q49,24 45,28" stroke="#000000" stroke-width="1.5" stroke-linecap="round" fill="none" />
					</svg>
				</span>
				<span class="error-digit">4</span>
			</div>
		</div>

		<!-- Article-style error message -->
		<div class="error-article">
			<h1 class="error-title">Page not found</h1>
			<p class="error-lead">
				<em>From {displayHost}, the free encyclopedia</em>
			</p>

			<hr />

			<p>
				The page you requested does not exist on <strong>Bengal Wiki</strong>. This may be because:
			</p>

			<ul class="error-reasons">
				<li>The article has not yet been written.</li>
				<li>The URL may contain a spelling error or incorrect capitalisation.</li>
				<li>The page may have been moved or deleted.</li>
				<li>You may have followed an outdated external link.</li>
			</ul>

			<p>You can try one of the following:</p>

			<div class="error-actions">
				<a href="/" class="action-btn primary">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
					Return to Main Page
				</a>
				<a href="/people" class="action-btn">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
					Eminent People
				</a>
				<a href="/places" class="action-btn">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
					Prominent Places
				</a>
				<a href="/songs" class="action-btn">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
					Songs
				</a>
			</div>

			<div class="error-search-hint">
				<p>Or use the <strong>search bar</strong> at the top of the page to find the article you are looking for.</p>
			</div>
		</div>

		<!-- Catlinks-style footer note -->
		<div class="catlinks" id="catlinks" data-mw="interface">
			<span class="catlinks-title">See also</span>:
			<ul class="catlinks-list">
				<li><a href="/about">About Bengal Wiki</a></li>
				<li><a href="/contact">Contact</a></li>
				<li><a href="/developers">Developers</a></li>
			</ul>
		</div>
	</div>
</Layout>

<style>
	.error-page {
		padding: 12px 0 48px;
	}

	/* Hero 404 number + globe display */
	.error-hero {
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 40px 0 32px;
	}

	.error-code-wrap {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.error-digit {
		font-family: var(--wiki-font-serif);
		font-size: clamp(5rem, 15vw, 9rem);
		font-weight: 700;
		color: #b11226;
		line-height: 1;
		opacity: 0.85;
		animation: digit-fade-in 0.6s ease both;
	}

	.error-digit:last-child {
		animation-delay: 0.15s;
	}

	.globe-svg {
		width: clamp(72px, 12vw, 120px);
		height: clamp(72px, 12vw, 120px);
		animation: globe-spin-in 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
		animation-delay: 0.05s;
		filter: drop-shadow(0 4px 12px rgba(177, 18, 38, 0.18));
	}

	@keyframes digit-fade-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 0.85;
			transform: translateY(0);
		}
	}

	@keyframes globe-spin-in {
		from {
			opacity: 0;
			transform: scale(0.5) rotate(-90deg);
		}
		to {
			opacity: 1;
			transform: scale(1) rotate(0deg);
		}
	}

	/* Article body */
	.error-article {
		max-width: 720px;
		animation: content-rise 0.5s ease 0.3s both;
	}

	@keyframes content-rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.error-title {
		font-size: 1.8rem;
		border-bottom: 1px solid var(--wiki-border);
		padding-bottom: 0.2em;
		margin-bottom: 0.25em;
	}

	.error-lead {
		font-size: 12px;
		color: var(--wiki-text-muted);
		margin-bottom: 0;
	}

	.error-reasons {
		margin: 0.75em 0 1em 2em;
	}

	/* Action buttons row */
	.error-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 1.25em 0 1.5em;
	}

	.action-btn {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 8px 16px;
		border: 1px solid var(--wiki-border);
		border-radius: 4px;
		font-size: 13px;
		color: var(--wiki-link);
		text-decoration: none;
		background-color: var(--wiki-highlight);
		transition: all 0.15s ease;
		font-family: var(--wiki-font-sans);
	}

	.action-btn:hover {
		background-color: var(--wiki-border-light);
		border-color: var(--wiki-border);
		color: var(--wiki-link-hover);
		text-decoration: none;
		transform: translateY(-1px);
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
	}

	.action-btn.primary {
		background-color: #b11226;
		border-color: #8e0e1e;
		color: #ffffff;
		font-weight: 600;
	}

	.action-btn.primary:hover {
		background-color: #8e0e1e;
		color: #ffffff;
	}

	.error-search-hint {
		background-color: var(--wiki-highlight);
		border: 1px solid var(--wiki-border-light);
		border-left: 3px solid #b11226;
		padding: 10px 14px;
		border-radius: 0 4px 4px 0;
		font-size: 13px;
	}

	/* Reuse site catlinks at bottom */
	.catlinks {
		margin-top: 48px;
	}

	@media (max-width: 600px) {
		.error-hero {
			padding: 24px 0 20px;
		}
		.error-actions {
			flex-direction: column;
		}
		.action-btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>
