---
interface Slide {
	image: string;
	caption?: string;
}

interface Props {
	gallery: Slide[];
	title?: string;
}

const { gallery, title = "Image Gallery" } = Astro.props;
---

{gallery && gallery.length > 0 && (
	<div class="wiki-slider-container" aria-label={title}>
		<div class="wiki-slider-wrapper">
			{gallery.map((slide, idx) => (
				<div 
					class={`wiki-slide ${idx === 0 ? 'active' : ''}`}
					data-index={idx}
					aria-hidden={idx === 0 ? 'false' : 'true'}
				>
					<img 
						src={slide.image} 
						alt={slide.caption || `${title} slide ${idx + 1}`} 
						class="wiki-slide-image"
						loading={idx === 0 ? "eager" : "lazy"}
					/>
					{slide.caption && (
						<div class="wiki-slide-caption">
							<span class="caption-text">{slide.caption}</span>
						</div>
					)}
				</div>
			))}
		</div>

		{gallery.length > 1 && (
			<>
				<button type="button" class="slider-nav-btn prev" aria-label="Previous image">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
				</button>
				<button type="button" class="slider-nav-btn next" aria-label="Next image">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
				</button>

				<div class="slider-indicators" role="tablist" aria-label="Slides selectors">
					{gallery.map((_, idx) => (
						<button
							type="button"
							class={`slider-dot-btn ${idx === 0 ? 'active' : ''}`}
							role="tab"
							aria-selected={idx === 0 ? 'true' : 'false'}
							aria-label={`Go to slide ${idx + 1}`}
							data-index={idx}
						/>
					))}
				</div>
			</>
		)}
	</div>
)}

<script>
	class WikiSlider {
		container: HTMLElement;
		slides: HTMLElement[];
		dots: HTMLButtonElement[];
		prevBtn: HTMLButtonElement | null;
		nextBtn: HTMLButtonElement | null;
		currentIndex: number;

		constructor(container: HTMLElement) {
			this.container = container;
			this.slides = Array.from(container.querySelectorAll('.wiki-slide'));
			this.dots = Array.from(container.querySelectorAll('.slider-dot-btn'));
			this.prevBtn = container.querySelector('.slider-nav-btn.prev');
			this.nextBtn = container.querySelector('.slider-nav-btn.next');
			this.currentIndex = 0;

			this.init();
		}

		init() {
			if (this.prevBtn) {
				this.prevBtn.addEventListener('click', () => this.showSlide(this.currentIndex - 1));
			}
			if (this.nextBtn) {
				this.nextBtn.addEventListener('click', () => this.showSlide(this.currentIndex + 1));
			}

			this.dots.forEach(dot => {
				dot.addEventListener('click', () => {
					const index = parseInt(dot.getAttribute('data-index') || '0', 10);
					this.showSlide(index);
				});
			});

			// Simple keyboard support when focused
			this.container.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.key === 'ArrowLeft') {
					this.showSlide(this.currentIndex - 1);
				} else if (e.key === 'ArrowRight') {
					this.showSlide(this.currentIndex + 1);
				}
			});
		}

		showSlide(index: number) {
			const total = this.slides.length;
			if (total <= 1) return;

			// Wrap index around
			let nextIndex = index;
			if (index < 0) {
				nextIndex = total - 1;
			} else if (index >= total) {
				nextIndex = 0;
			}

			// Deactivate current slide
			this.slides[this.currentIndex].classList.remove('active');
			this.slides[this.currentIndex].setAttribute('aria-hidden', 'true');
			if (this.dots[this.currentIndex]) {
				this.dots[this.currentIndex].classList.remove('active');
				this.dots[this.currentIndex].setAttribute('aria-selected', 'false');
			}

			// Activate next slide
			this.slides[nextIndex].classList.add('active');
			this.slides[nextIndex].setAttribute('aria-hidden', 'false');
			if (this.dots[nextIndex]) {
				this.dots[nextIndex].classList.add('active');
				this.dots[nextIndex].setAttribute('aria-selected', 'true');
			}

			this.currentIndex = nextIndex;
		}
	}

	// Initialize all sliders on the page
	document.addEventListener('DOMContentLoaded', () => {
		const sliders = document.querySelectorAll('.wiki-slider-container');
		sliders.forEach(slider => {
			new WikiSlider(slider as HTMLElement);
		});
	});
</script>

<style>
	.wiki-slider-container {
		position: relative;
		width: 100%;
		max-width: 760px;
		margin: 24px auto;
		background: #0b0f19;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
		border: 1px solid rgba(255, 255, 255, 0.08);
		aspect-ratio: 16 / 9;
		display: flex;
		flex-direction: column;
	}

	.wiki-slider-wrapper {
		position: relative;
		width: 100%;
		height: 100%;
		flex: 1;
		overflow: hidden;
	}

	.wiki-slide {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.5s ease, visibility 0.5s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.wiki-slide.active {
		opacity: 1;
		visibility: visible;
	}

	.wiki-slide-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.wiki-slide-caption {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.85) 100%);
		padding: 16px 24px 32px 24px;
		color: #ffffff;
		font-family: var(--wiki-font-sans);
		font-size: 13px;
		line-height: 1.5;
		text-align: center;
		z-index: 2;
	}

	.caption-text {
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
		max-width: 90%;
		display: inline-block;
	}

	/* Nav buttons (Glassmorphic) */
	.slider-nav-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.15);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.25);
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.2s ease;
		z-index: 5;
		outline: none;
	}

	.slider-nav-btn:hover {
		background: rgba(255, 255, 255, 0.3);
		border-color: rgba(255, 255, 255, 0.5);
		transform: translateY(-50%) scale(1.05);
	}

	.slider-nav-btn:active {
		transform: translateY(-50%) scale(0.95);
	}

	.slider-nav-btn.prev {
		left: 16px;
	}

	.slider-nav-btn.next {
		right: 16px;
	}

	/* Indicators/Dots */
	.slider-indicators {
		position: absolute;
		bottom: 12px;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 8px;
		z-index: 6;
		background: rgba(0, 0, 0, 0.4);
		padding: 6px 12px;
		border-radius: 20px;
		backdrop-filter: blur(4px);
	}

	.slider-dot-btn {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.4);
		border: none;
		cursor: pointer;
		padding: 0;
		transition: all 0.2s ease;
		outline: none;
	}

	.slider-dot-btn:hover {
		background: rgba(255, 255, 255, 0.8);
	}

	.slider-dot-btn.active {
		background: #ffffff;
		transform: scale(1.25);
	}

	/* Responsive styling */
	@media (max-width: 600px) {
		.wiki-slider-container {
			aspect-ratio: 4 / 3;
			margin: 16px 0;
			border-radius: 8px;
		}
		.slider-nav-btn {
			width: 36px;
			height: 36px;
		}
		.slider-nav-btn.prev { left: 8px; }
		.slider-nav-btn.next { right: 8px; }
		.wiki-slide-caption {
			padding: 12px 16px 24px 16px;
			font-size: 11px;
		}
	}
</style>
